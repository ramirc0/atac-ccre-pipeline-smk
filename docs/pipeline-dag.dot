// Simplified data flow of workflow/Snakefile.
// Render: dot -Tpdf docs/pipeline-dag.dot -o docs/pipeline-dag.pdf
//         dot -Tsvg docs/pipeline-dag.dot -o docs/pipeline-dag.svg
//         dot -Tpng -Gdpi=300 docs/pipeline-dag.dot -o docs/pipeline-dag.png
digraph pipeline {
    graph [rankdir=TB, fontname="Anthropic Sans Text", nodesep=0.4, ranksep=0.45,
           label="ATAC cCRE Pipeline",
           labelloc=t, fontsize=14];
    node  [fontname="Anthropic Sans Text", fontsize=10];
    edge  [color="grey40", fontname="Anthropic Sans Text"];

    // Inputs
    node [shape=cylinder, style=filled, fillcolor="#dbe9f6"];
    custom_np  [label="ATAC narrowPeaks\nsample sheet: narrowpeak\n(122 custom samples)"];
    custom_bw  [label="ATAC bigWigs\nsample sheet: bigwig"];
    encode_atac [label="ENCODE ATAC sheet\nencode-atac.2026-09-23.tsv", style="filled,dashed"];
    dnase      [label="ENCODE DNase bigWigs\ndnase.list\n(1325 experiments)"];
    rdhs       [label="V4 anchors (fixed)\nrDHSs + TF rClusters\nGRCh38-Anchors.bed\n2,950,228 anchors"];
    blacklist  [label="ENCODE blacklist\nENCFF356LFX.bed"];
    ccres      [label="V4 Registry cCREs (fixed)\ncell type-agnostic\nGRCh38-cCREs.bed\n2,348,854 cCREs"];

    // Steps
    node [shape=box, style="rounded,filled", fillcolor="#f2f2f2"];
    prep       [label="prepare_peaks\nresize peaks to 150-350 bp\naround summit"];
    subgraph cluster_encode {
        label="Optional: ENCODE ATAC for QC and benchmarking\n(add the ENCODE sheet to samples)";
        labelloc=t; labeljust=r; style="dashed,rounded"; color="grey50"; fontsize=11;
        encode_atac;
    }
    subgraph cluster_rapeaks {
        label="ATAC rOCR calling\n(same method as rDHSs and TF rClusters)";
        labelloc=b; labeljust=l; style=dashed; color="grey50"; fontsize=11;
        prep; cluster; filter;
    }
    cluster    [label="cluster_rpeaks\niteratively merge overlaps,\nkeep strongest peak = rOCRs"];
    filter     [label="filter_rpeaks\nkeep rOCRs in >= 5 experiments,\ndrop anchor and blacklist overlaps\n= rAPeaks"];
    accession  [label="accession_rpeaks\nrAPeaks become new ATAC anchors\n(EH38A IDs)"];
    anchors    [label="anchors\nV4 anchors + new ATAC anchors"];
    maxz       [label="zscore, max_z\n(z-score of log10 signal)\nacross ATAC samples and DNase experiments"];
    call       [label="call_ccres\nnew ATAC anchors with ATAC max-Z > 1.64\nbecome ATAC cCREs,\nadded to the V4 Registry"];

    // Final outputs
    subgraph outputs {
        node [shape=note, style=filled, fillcolor="#d9f2d9", color="#2e7d32", penwidth=2, fontsize=12];
        out_anchors [label=<<b>Anchors-ATAC.bed</b><br/><font point-size="10">V4 anchors + new ATAC anchors</font>>];
        out_amax    [label=<<b>ATAC-maxZ.txt</b><br/><font point-size="10">ATAC max-Z per anchor</font>>];
        out_dmax    [label=<<b>DNase-maxZ.txt</b><br/><font point-size="10">DNase max-Z per anchor</font>>];
        out_ccres   [label=<<b>cCREs.bed</b><br/><font point-size="10">V4 Registry cCREs + ATAC cCREs</font>>];
        { rank=same; out_anchors; out_amax; out_dmax; out_ccres; }
    }

    encode_atac -> prep [style=dashed];
    encode_atac -> maxz [style=dashed];
    custom_np -> prep;
    prep -> cluster;
    cluster -> filter;
    rdhs -> filter;
    blacklist -> filter;
    filter -> accession -> anchors;
    rdhs -> anchors;

    anchors -> out_anchors;
    anchors -> maxz;
    custom_bw -> maxz;
    dnase -> maxz;
    maxz -> out_amax;
    maxz -> out_dmax;
    maxz -> call [label=" ATAC max-Z", fontsize=9];
    ccres -> call;
    call -> out_ccres;

    { rank=same; custom_bw; dnase; }
}
